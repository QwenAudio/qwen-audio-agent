# Alibaba Cloud Model Studio API key. The example maps it to VoiceMem's
# OpenAI-compatible client automatically.
DASHSCOPE_API_KEY=your_dashscope_api_key

# Select the first-party optional MemoryProvider shipped by qwen-audio-agent.
QWEN_AUDIO_MEMORY_PROVIDER=voicemem

# Memory input: text (default, lightweight) or audio (VoiceMem-native
# ASR, voiceprint, emotion, and acoustic perception).
VOICEMEM_INPUT_MODE=text

# Keep this example isolated from the user's regular Gateway configuration.
AGENT_PROTOCOL=none
QWAUDIO_CONFIG_DIR=.qwen-audio/runtime
QWAUDIO_DATA_DIR=.qwen-audio/runtime

# Recommended defaults. Uncomment only when you need to override them.
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VOICEMEM_CHAT_MODEL=qwen3.8-flash
# VOICEMEM_EMBEDDING_MODEL=text-embedding-v4
# VOICEMEM_EMBED_DIM=1024
# VOICEMEM_MEMORY_LANGUAGE=zh
# VOICEMEM_ASR=funasr
# Voiceprint needs VoiceMem's separate speaker model. Keep it off until that
# model is installed and VOICEMEM_SPEAKER_MODEL/VOICEMEM_MODELS_DIR is set.
VOICE_ENABLE_VOICEPRINT=false

# Optional runtime overrides.
# VOICEMEM_PYTHON=/absolute/path/to/python
# The example launcher fills this automatically. Set an absolute path when
# enabling VoiceMem from the regular Gateway configuration.
# VOICEMEM_SIDECAR=/absolute/path/to/examples/voicemem/sidecar/server.py
# PORT=3102
