# 复制为 .env.local 后填写。.env.local 不提交。
# 上游 Realtime（必填）
DASHSCOPE_API_KEY=

# 网关监听
DH_GATEWAY_HOST=127.0.0.1
DH_GATEWAY_PORT=18895

# Renderer：留空时 start.mjs 自动启动本地 Mock renderer
DH_RENDERER_URL=
# 远端 renderer 控制面的 Bearer token：一旦填了 DH_RENDERER_URL 就必填，
# 留空则建会话返回 401；本地 Mock 模式忽略此项。
# GPU 机上通常在 ~/.config/dhav-bridge/token（渲染端读的变量名是 DHAV_AUTH_TOKEN，
# 同一个密钥两个名字）。请勿提交、勿贴进公共日志。
DH_RENDERER_TOKEN=
# 启动时选择的人设（须在服务端 personas 白名单内）
# 本地 Mock 只认 mock-default；远端 FlashHead 用 flashhead-default
DH_PERSONA=mock-default

# Mock renderer 故障注入（测试用）：
#   first_media_timeout | media_stall | protocol_error | mid_turn_failure | channel_drop
DH_MOCK_FAULT=

# Mock renderer 监听（仅本地 Mock 模式）
DH_MOCK_RENDERER_HOST=127.0.0.1
DH_MOCK_RENDERER_PORT=0

# 数字人音色（Audio 模型族）。不由 bootstrap/env.mjs 读取，而是随 .env.local
# 载入 process.env 后由框架的 realtime provider 解析。保持注释即用 provider 默认音色；
# 注意写成空值（QWEN_AUDIO_REALTIME_VOICE=）在框架里是「显式清空」语义，会回落到
# 别名变量，所以要么整行注释掉、要么填一个具体音色。
# 可选：longanqian / longanlingxin / longanlingxi / longanxiaoxin / longanlufeng
# QWEN_AUDIO_REALTIME_VOICE=longanxiaoxin

# Realtime 模型。compose-gateway.mjs 用 ||= 设默认值，所以这里显式写值即可覆盖。
# avatar 目前只与 Audio 模型族配对（无摄像头输入，只协商 recvonly 视频下行）。
# QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus

# 关闭网关访问令牌（仅本地开发/测试；留空即禁用鉴权）
QWEN_AUDIO_GATEWAY_ACCESS_TOKEN=
