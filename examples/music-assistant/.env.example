# Copy to .env in this directory, or export the variables in your shell.
# The provider key stays on the Gateway. The mobile client never sees it.
QWEN_AUDIO_REALTIME_API_KEY=

# Optional: realtime voice model override (default: qwen-audio-3.1-realtime-plus).
# QWEN_AUDIO_REALTIME_MODEL=

# Optional: only needed when the client connects from another device (e.g. a real
# phone over LAN). Set HOST=0.0.0.0 as well, and use a token of >= 24 characters.
# iOS Simulator shares the Mac network stack, so ws://127.0.0.1:3101 needs no token.
# HOST=0.0.0.0
# QWEN_AUDIO_GATEWAY_ACCESS_TOKEN=
