# 一套前台连接配置 / One active frontend connection.
# 默认使用 Qwen Audio 3.1 Realtime Plus；填写 DashScope API Key 即可。
QWEN_AUDIO_REALTIME_PROVIDER=dashscope
QWEN_AUDIO_REALTIME_API_KEY=
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
# URL、MODEL、VOICE 留空时使用供应商/模型默认值。
# Empty URL, MODEL, or VOICE uses the provider/model default.
QWEN_AUDIO_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_REALTIME_VOICE=
# 音色留空跟随模型；默认模型音色 / Default model voice: longanqian_v3.1.
# 支持 / Providers: dashscope, stepfun, gpt-live, google-live,
# doubao-seeduplex, speech-to-speech, minicpm-o.
# 切换供应商时同步替换 Key、模型，清空或替换 URL、音色。
# Switching provider: replace its key/model and clear or replace its URL/voice.
# speech-to-speech / minicpm-o: 模型和音色在上游配置，以上 MODEL、VOICE 留空；
# URL 默认指向本机服务，API_KEY 仅在服务启用 Bearer 认证时填写。
# These two services own model/voice selection; keep MODEL and VOICE empty.
# Their default URLs target localhost; API_KEY is an optional Bearer token.
# Omni 3.8 需业务空间专属 URL / Omni 3.8 requires a workspace endpoint:
# QWEN_AUDIO_REALTIME_MODEL=qwen3.8-omni-flash-realtime
# QWEN_AUDIO_REALTIME_URL=wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# 其他前台默认值与能力限制 / Defaults and limits: docs/configuration/frontend.md.
# 额外模型登记 / Additional model registrations: <QWAUDIO_CONFIG_DIR>/frontend-models.json.
# 可选路径；相对路径基于配置目录 / Optional path, relative to the configuration directory.
# QWEN_AUDIO_FRONTEND_MODELS_CONFIG=frontend-models.json
# 仅登记已支持 API 的模型；连接信息仍在本文件。示例见 docs/configuration/frontend.md。

# Web Search 默认使用无需 Key、国内可访问的简易 Bing HTML Adapter。
# 开通百炼联网搜索 MCP 后，可显式选择 bailian；也可关闭或使用自定义 MCP。
# QWEN_AUDIO_WEB_SEARCH_PROVIDER=bailian
# QWEN_AUDIO_WEB_SEARCH_PROVIDER=none
# QWEN_AUDIO_WEB_SEARCH_MCP_URL=https://example.com/mcp
# QWEN_AUDIO_WEB_SEARCH_MCP_TOKEN=
# QWEN_AUDIO_WEB_SEARCH_MCP_TOOL=web_search

# 可选前台工具默认按已配置的 Provider 和运行能力自动启用；设为 false 可隐藏。
# QWEN_AUDIO_SCHEDULE_TOOL_ENABLED=false
# QWEN_AUDIO_WEB_TOOLS_ENABLED=false
# QWEN_AUDIO_KNOWLEDGE_TOOL_ENABLED=false
# QWEN_AUDIO_NOTES_TOOL_ENABLED=false
# QWEN_AUDIO_RECALL_TOOL_ENABLED=false

# 可选：选择后台 Agent；留空时仅使用前台实时语音聊天。
# OpenCode/OpenClaw 支持自动安装和百炼配置。
# 可选 openclaw、opencode、qoder、qwen、minimax、kimi、hermes、
# codebuddy、codex、claude、pi、muse、通用 acp 或 none。
AGENT_PROTOCOL=openclaw

# 配置后台后，Gateway 默认启动并管理所选 Agent 的后台进程。
# 权限模式：native（后台自行询问）或 full（最高权限）；
# Pi 没有权限审批机制，无论配置什么都始终生效 full。
# QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native
# QWEN_AUDIO_AGENT_BACKEND_AGENT=
# 可选：通过 ACP 标准覆盖 Session 模型；OpenCode/OpenClaw 托管初始化也会使用。
# 后台未声明 ACP 模型选项时请留空，沿用 Agent 原有配置
# QWEN_AUDIO_AGENT_BACKEND_MODEL=

# 可选：OpenCode 地址用于本地 UI 服务；显式 OpenClaw 地址表示外部 Gateway。
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# External/user-managed Gateway: http(s):// or ws(s)://. Prefer wss:// remotely.
# OPENCLAW_BASE_URL=wss://openclaw.example.com
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_TOKEN_FILE=
# If a local security policy blocks the bundled launcher, run this trusted
# OpenClaw executable directly as the lightweight ACP bridge.
# OPENCLAW_ACP_BIN=/absolute/path/to/openclaw

# Qoder 默认复用 qodercli 的登录和原生 Session 存储。
# QODERCLI_PATH=
# QODER_AUTH_MODE=cli

# Qwen Code 使用官方 qwen --acp，复用 ~/.qwen 中的认证、模型、MCP 和 Skill。
# QWEN_CODE_BIN=
# QWEN_CODE_WORKSPACE=

# MiniMax Code 使用官方 mcode acp；首次认证运行 mcode login。
# 自定义 Provider/API Key 请通过 mcode provider 配置，不要写入本文件。
# MINIMAX_CODE_BIN=
# MINIMAX_CODE_WORKSPACE=

# Kimi Code 使用官方 kimi acp；可复用原生登录，或通过官方临时模型变量传入凭据。
# KIMI_CODE_BIN=
# KIMI_WORKSPACE=
# KIMI_CODE_HOME=
# KIMI_MODEL_NAME=kimi-for-coding
# KIMI_MODEL_API_KEY=
# KIMI_MODEL_BASE_URL=https://api.kimi.com/coding/v1

# Hermes 使用自己的模型与 provider 配置。
# HERMES_BIN=
# HERMES_WORKSPACE=

# CodeBuddy 需要先通过交互式 /login 完成一次账号登录。
# CODEBUDDY_BIN=
# CODEBUDDY_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# CODEBUDDY_WORKSPACE=

# Codex 通过 codex-acp 接入，并复用已安装 Codex 的用户配置。
# CODEX_ACP_BIN=
# CODEX_ACP_RUNTIME=auto
# CODEX_PATH=
# CODEX_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CODEX_WORKSPACE=

# Claude Code 通过 claude-code-acp 接入，并复用已安装客户端的配置。
# CLAUDE_CODE_ACP_BIN=
# CLAUDE_CODE_ACP_RUNTIME=auto
# CLAUDE_CODE_EXECUTABLE=
# CLAUDE_WORKSPACE=

# Pi 通过社区适配器 pi-acp 接入，复用已安装 Pi 的认证与配置；
# 认证请在终端运行 pi 后通过 /login 完成，或配置 ANTHROPIC_API_KEY 等官方模型变量。
# 注意：Pi 没有权限审批机制，任何模式下都直接执行命令和修改文件。
# PI_BIN=
# PI_ACP_BIN=
# PI_ACP_RUNTIME=auto
# PI_WORKSPACE=

# Muse Code 通过官方 Muse Session Protocol（MSP）SDK 接入；首次使用前运行
# muse 并完成 Meta Developer 账号登录或 API Key 配置。
# MUSE_CODE_BIN=muse
# MUSE_CODE_WORKSPACE=
# Windows + WSL 部署时，将 MUSE_CODE_BIN 设为 wsl.exe，并传入完整的 serve 参数：
# MUSE_CODE_BIN=C:\\Windows\\System32\\wsl.exe
# MUSE_CODE_ARGS=["--distribution","Ubuntu-24.04","--user","muse","--","env","HOME=/home/muse","PATH=/home/muse/.local/bin:/usr/local/bin:/usr/bin:/bin","/home/muse/.local/bin/muse","serve"]
# MUSE_CODE_HOST_WORKSPACE=E:\\qwen-audio-agent
# MUSE_CODE_WORKSPACE=/home/muse/workspace

# 任意支持 ACP stdio 的 Agent 可通过通用入口接入；参数建议使用 JSON 数组。
# AGENT_PROTOCOL=acp
# ACP_COMMAND=your-agent
# ACP_ARGS=["--acp"]
# ACP_LABEL=Your Agent
# ACP_WORKSPACE=

# 可选：使用本机已安装并登录的 Tailscale，将 Gateway 发布到私有 Tailnet。
# QWEN_AUDIO_GATEWAY_TAILNET=1
# 对外直连地址不通过配置文件声明，改由 qwenaudio gateway pair --endpoint 指定，
# 见 docs/operations/remote-access.md。
# 通过浏览器远程访问时，还需显式允许公开 Origin。
# QWEN_AUDIO_AGENT_ALLOWED_ORIGINS=https://voice.example.com

# 前台记忆的三项能力，都默认关闭。开启会带来额外的模型调用（用 memory 那套
# 凭据：QWEN_AUDIO_MEMORY_API_KEY / _MODEL / _BASE_URL），所以由用户显式选择。

# 偏好自更新：会话结束后从这一场里观察用户画像，跨会话攒够确认再写进 USER.md
# 的「观察推断」段。该段与「用户明确要求」物理分开，冲突时明说恒优先。
# 只观察四个字段：职业、擅长的技术、回答长短、回答风格。
# QWEN_AUDIO_PREFERENCE_LEARNING=on

# 会话摘要：会话结束后记下这一场的话题与一句要点（保留 90 天），供 recall 工具
# 回答「前几天我们聊的那个」。摘要不注入 instructions —— 它每场都变，注入会让
# prompt 前缀每场都变、前缀缓存失效。
# QWEN_AUDIO_SESSION_DIGEST=on

# 本机资料库：把用户指定的本机文件收进 共享数据目录中的 knowledge/documents，供 knowledge 工具检索。
# 前端只存标题、一句说明、章节标题和路径，正文留在文件里由后端自己读。
# 开启后若没有另外注入 knowledgeProvider，它会自动成为那个 Provider。
# 需要 PDF / Word 时由后端提取文字，因此后端必须能读到源文件。
# QWEN_AUDIO_DOMAIN_LIBRARY=on

# GPT-Live 1 only (QWEN_AUDIO_REALTIME_PROVIDER=gpt-live-1)
# GPT_LIVE_1_DELEGATION_MODEL=gpt-6-luna
# GPT_LIVE_1_OUTPUT_IDLE_MS=1500
# GPT_LIVE_1_WORD_GAP_MS=600
# GPT_LIVE_1_INPUT_SEGMENT_GAP_MS=1200
# GPT_LIVE_1_INPUT_IDLE_MS=2000
