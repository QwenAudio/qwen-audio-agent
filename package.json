{
  "name": "qwen-audio-agent",
  "desktopName": "qwen-audio-agent.desktop",
  "version": "1.6.0",
  "description": "A realtime voice frontend for mainstream AI agents.",
  "author": "qwen-audio-agent contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenAudio/qwen-audio-agent.git"
  },
  "bugs": {
    "url": "https://github.com/QwenAudio/qwen-audio-agent/issues"
  },
  "homepage": "https://github.com/QwenAudio/qwen-audio-agent#readme",
  "keywords": [
    "qwen",
    "audio",
    "voice",
    "agent",
    "opencode",
    "openclaw",
    "qoder",
    "kimi-code",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "qwenaudio": "cli/bin/qwenaudio.mjs"
  },
  "files": [
    "cli/bin/",
    "cli/src/",
    "cli/package.json",
    "config/frontend-agent/",
    "config/openclaw/openclaw.json5",
    "config/openclaw/workspace/AGENTS.md",
    "config/hermes/workspace/AGENTS.md",
    "config/codebuddy/workspace/AGENTS.md",
    "config/codebuddy/workspace/.codebuddy/models.json",
    "config/codex/workspace/AGENTS.md",
    "config/claude/workspace/AGENTS.md",
    "config/acp/workspace/AGENTS.md",
    "config/opencode/workspace/AGENTS.md",
    "config/qoder/workspace/AGENTS.md",
    "config/kimi/workspace/AGENTS.md",
    "docs/architecture.md",
    "docs/architecture.zh.md",
    "docs/architecture-overview.png",
    "docs/architecture-overview-en.png",
    "docs/desktop-fluid-orb-thinking.gif",
    "docs/desktop-goo-orb-thinking.gif",
    "docs/qwen-audio-agent-three-layer-architecture.png",
    "docs/qwen-audio-agent-three-layer-architecture-en.png",
    "docs/configuration.md",
    "docs/configuration.zh.md",
    "docs/backends/overview.md",
    "docs/backends/overview.zh.md",
    "docs/desktop/overview.md",
    "docs/desktop/overview.zh.md",
    "docs/getting-started/install.md",
    "docs/getting-started/install.zh.md",
    "docs/getting-started/quickstart.md",
    "docs/getting-started/quickstart.zh.md",
    "docs/getting-started/tui.md",
    "docs/getting-started/tui.zh.md",
    "docs/reference/memory.md",
    "docs/reference/memory.zh.md",
    "docs/voice-frontends/speech-to-speech.md",
    "docs/voice-frontends/speech-to-speech.zh.md",
    "server/src/",
    "server/package.json",
    "shared/",
    "scripts/",
    "tui/native/",
    "tui/src/index.mjs",
    "tui/src/macos-voice-io.mjs",
    "tui/src/portaudio-voice-io.mjs",
    "tui/package.json",
    "web/dist/",
    "README_ZH.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "server",
    "web",
    "tui",
    "desktop",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspace web --no-global",
    "prepare": "node scripts/prepare-build.mjs",
    "install:global": "node scripts/install-global.mjs",
    "start": "node scripts/start.mjs",
    "pregateway": "npm run build",
    "gateway": "npm run start --workspace server",
    "desktop": "npm run start --workspace desktop",
    "test:desktop-smoke": "node scripts/electron-smoke.mjs",
    "desktop:build": "node scripts/check-desktop-release-env.mjs && npm run build && electron-builder --config desktop/electron-builder.yml --mac dmg zip",
    "desktop:build:local": "npm run build && electron-builder --config desktop/electron-builder.yml --config.mac.identity=- --config.mac.hardenedRuntime=false --config.mac.notarize=false --mac dmg",
    "desktop:build:linux": "npm run build && electron-builder --config desktop/electron-builder.yml --linux AppImage deb",
    "desktop:build:win": "npm run build && electron-builder --config desktop/electron-builder.yml --win --x64 --publish never",
    "cli": "npm run start --workspace @qwen-audio-agent/cli --",
    "tui": "npm run start --workspace tui --",
    "backend": "node scripts/start.mjs",
    "openclaw": "node scripts/openclaw-gateway.mjs",
    "opencode": "node scripts/opencode-server.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs && npm run test --workspace server && npm run test --workspace web && npm run test --workspace tui && npm run test --workspace desktop && npm run test --workspace @qwen-audio-agent/cli",
    "audit:release": "node scripts/audit-dependencies.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:patch": "node scripts/set-version.mjs patch",
    "version:minor": "node scripts/set-version.mjs minor",
    "version:major": "node scripts/set-version.mjs major",
    "release:check": "./scripts/release-check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "6.8.9",
    "express": "^4.22.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "sherpa-onnx": "1.13.4",
    "tar-stream": "3.1.7",
    "unbzip2-stream": "1.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron-builder": "26.15.7",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6"
  }
}
