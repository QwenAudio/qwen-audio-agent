# Start/configure the official Gateway separately. No model keys belong here.
DH_GATEWAY_URL=ws://127.0.0.1:18888/api/realtime
# Optional Gateway access token; retained in the local Node service.
DH_GATEWAY_TOKEN=
DH_CLIENT_PORT=5273

# Example-local adapter id: dhav or experimental vidu. See provider-contract.zh.md.
# No Gateway changes are required.
DH_RENDERER_ADAPTER=dhav
# Empty URL starts the local synthetic renderer (no GPU, no avatar model).
DH_RENDERER_URL=
DH_RENDERER_TOKEN=
DH_PERSONA=mock-default
# Self-deployed FlashHead: set URL/token and DH_PERSONA=flashhead-default.

# Optional mock-only fault: first_media_timeout | media_stall | protocol_error |
# mid_turn_failure | channel_drop
DH_MOCK_FAULT=

# Optional Vidu Component / native ARTC preview. Switch DH_RENDERER_ADAPTER=vidu.
# Public Vidu API has NO verifiable per-reply media-end marker. Disabled by
# default; preview does not negotiate playback.receipts or acknowledge playback.
# Not suitable for reliable task announcements/delivery confirmation; PR stays Draft.
# Interrupt retires the live/channel; the next reply reconnects (latency/charges).
VIDU_EXPERIMENTAL=0
VIDU_API_KEY=vda_replace_me
ARTC_APP_ID=
ARTC_APP_KEY=
VIDU_HOST=api.vidu.cn
