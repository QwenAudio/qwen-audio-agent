  "packageManager": "npm@10.9.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "server",
    "web",
    "tui",
    "desktop",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspace web --no-global",
    "prepare": "node scripts/prepare-build.mjs",
    "install:global": "node scripts/install-global.mjs",
    "start": "node scripts/start.mjs",
    "pregateway": "npm run build",
    "gateway": "npm run start --workspace server",
    "desktop": "npm run start --workspace desktop",
    "test:desktop-smoke": "node scripts/electron-smoke.mjs",
    "desktop:build": "node scripts/check-desktop-release-env.mjs && npm run build && electron-builder --config desktop/electron-builder.yml --mac dmg zip",
    "desktop:build:local": "npm run build && electron-builder --config desktop/electron-builder.yml --config.mac.identity=- --config.mac.hardenedRuntime=false --config.mac.notarize=false --mac dmg",
    "desktop:build:linux": "npm run build && electron-builder --config desktop/electron-builder.yml --linux AppImage deb",
    "desktop:build:win": "npm run build && electron-builder --config desktop/electron-builder.yml --win --x64 --publish never",
    "cli": "npm run start --workspace @qwen-audio-agent/cli --",
    "tui": "npm run start --workspace tui --",
    "backend": "node scripts/start.mjs",
    "openclaw": "node scripts/openclaw-gateway.mjs",
    "opencode": "node scripts/opencode-server.mjs",
    "example:smart-cockpit:install": "npm install --prefix examples/smart-cockpit/service && npm install --prefix examples/smart-cockpit/agent && npm install --prefix examples/smart-cockpit/client",
    "example:smart-cockpit:preflight": "node examples/smart-cockpit/bootstrap/preflight.mjs",
    "example:smart-cockpit:service": "node examples/smart-cockpit/service/server.mjs",
    "example:smart-cockpit:agent": "node examples/smart-cockpit/agent/server.mjs",
    "example:smart-cockpit:gateway": "node examples/smart-cockpit/gateway/server.mjs",
    "example:smart-cockpit:client": "npm run dev --prefix examples/smart-cockpit/client",
    "example:smart-cockpit": "npm run example:smart-cockpit:preflight && concurrently -n service,agent,gateway,client -c yellow,cyan,green,magenta --kill-others-on-fail \"npm run example:smart-cockpit:service\" \"npm run example:smart-cockpit:agent\" \"npm run example:smart-cockpit:gateway\" \"npm run example:smart-cockpit:client\"",
    "example:smart-cockpit:build": "npm run build --prefix examples/smart-cockpit/client",
    "example:smart-cockpit:lint": "npm run lint --prefix examples/smart-cockpit/client",
    "lint": "eslint .",
    "docs:dev": "concurrently -n sync,site -c yellow,magenta \"node scripts/sync-docs-site.mjs --watch\" \"vitepress dev docs\"",
    "predocs:dev": "node scripts/sync-docs-site.mjs",
    "predocs:build": "node scripts/sync-docs-site.mjs",
    "docs:build": "vitepress build docs",
    "predocs:preview": "node scripts/sync-docs-site.mjs",
    "docs:preview": "vitepress preview docs",
    "eval:frontend": "node server/eval/run-frontend-evaluations.mjs",
    "test": "node --test test/*.test.mjs && npm run test --workspace server && npm run test --workspace web && npm run test --workspace tui && npm run test --workspace desktop && npm run test --workspace @qwen-audio-agent/cli && npm run test:smart-cockpit",
    "pretest:smart-cockpit": "npm ci --prefix examples/smart-cockpit/service --ignore-scripts && npm ci --prefix examples/smart-cockpit/agent --ignore-scripts",
    "test:smart-cockpit": "npm test --prefix examples/smart-cockpit/service && npm test --prefix examples/smart-cockpit/agent && node --test examples/smart-cockpit/bootstrap/test/*.test.mjs examples/smart-cockpit/client/test/*.test.mjs examples/smart-cockpit/gateway/test/*.test.mjs examples/smart-cockpit/test/*.test.mjs",
    "audit:release": "node scripts/audit-dependencies.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:patch": "node scripts/set-version.mjs patch",
    "version:minor": "node scripts/set-version.mjs minor",
    "version:major": "node scripts/set-version.mjs major",
    "release:check": "./scripts/release-check"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@agentclientprotocol/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
