{
  "domain": "navigation",
  "label": "导航",
  "description": "座舱示例的地点搜索、路线规划、开始导航与停止导航能力。",
  "enabled": true,
  "functions": [
    {
      "name": "navigation_start",
      "label": "开始导航",
      "description": "搜索目的地、规划驾车路线并开始导航。",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "description": "目的地名称或地址"
          },
          "via": {
            "type": "string",
            "description": "途经点（可选）"
          },
          "strategy": {
            "type": "number",
            "enum": [
              0,
              13,
              5,
              4,
              11,
              14,
              2
            ],
            "description": "路线偏好: 0=智能推荐, 13=高速优先, 5=不走高速, 4=躲避拥堵, 11=少收费, 14=大路优先, 2=时间优先。当用户提及路线偏好时设置此参数"
          }
        },
        "required": [
          "destination"
        ]
      }
    },
    {
      "name": "navigation_route_query",
      "label": "路线查询",
      "description": "搜索目的地并规划驾车路线，但不开始导航。",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "description": "目的地名称或地址"
          },
          "via": {
            "type": "string",
            "description": "途经点（可选）"
          },
          "strategy": {
            "type": "number",
            "enum": [
              0,
              13,
              5,
              4,
              11,
              14,
              2
            ],
            "description": "路线偏好: 0=智能推荐, 13=高速优先, 5=不走高速, 4=躲避拥堵, 11=少收费, 14=大路优先, 2=时间优先。当用户提及路线偏好时设置此参数"
          }
        }
      }
    },
    {
      "name": "navigation_stop",
      "label": "停止导航",
      "description": "停止当前导航并清空地图路线。",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  ]
}
