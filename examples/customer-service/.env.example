# 客服示例的场景端点。默认端口只用于本地示例。
#
# 五个进程：service（业务状态与两个 MCP 面）、agent（后台 A2A，走 auth_required
# 批准链）、gateway（语音前台）、client（客服工作台）、desk（人工坐席台）。
# 一条命令全起：npm run example:customer-service
# 同时起两个域：npm run example:customer-service:both（航空端口 +100）

CS_SERVICE_HOST=127.0.0.1
# 业务域。决定四样东西：人设（gateway/assistant/*.md）、前台工具白名单、
# policy 检索源、state-store 的默认库。改了要重启网关才生效。
CS_DOMAIN=retail

CS_SERVICE_PORT=3110
CS_SERVICE_ORIGIN=http://127.0.0.1:3110

# 前台 MCP 端点，默认由 CS_SERVICE_ORIGIN 推导，一般不用显式设置。
# CS_FRONTEND_MCP_URL=http://127.0.0.1:3110/mcp/frontend?sessionId=default

# 端口选择避开 smart-cockpit（3010/3020/18888/5173）。
CS_AGENT_HOST=127.0.0.1
CS_AGENT_PORT=3120
CS_AGENT_CARD_URL=http://127.0.0.1:3120/.well-known/agent-card.json
CS_GATEWAY_HOST=127.0.0.1
CS_GATEWAY_PORT=18889
CS_CLIENT_HOST=127.0.0.1
# 客服工作台。默认 4620；bootstrap/start.mjs 起航空组时自动 +100（4720）。
CS_CLIENT_PORT=4620
# 人工坐席台。转人工之后这一页会亮起来。航空组是 4730。
CS_DESK_PORT=4630

# 同一个 sessionId 下 UI 与 Agent 才能看到同一份业务状态。
CS_SESSION_ID=default

# 后台 Agent 的模型（OpenAI 兼容的 DashScope API）。
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen3.8-flash
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 语音前台所需（DashScope Realtime，WebSocket 协议，和上面的 chat completions 不是一个端点）。
QWEN_AUDIO_REALTIME_BASE_URL=
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_AUDIO_REALTIME_VOICE=longanqian

# Policy 配置台的抽取模型。抽取跑三次取分歧，所以用 flash 级别压成本。
# CS_EXTRACT_MODEL=qwen-flash
# 抽取时给不给模型看数据库：tools（默认，多轮探查）/ summary / blind。
# blind 快一倍但发现不了「库里有但 policy 没提」这类缺口。
# CS_EXTRACT_PROBE=tools
