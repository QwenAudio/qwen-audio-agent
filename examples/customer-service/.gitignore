node_modules/
.env.local
runtime/
# 抽取缓存。一次抽取要跑 3 遍模型约一分钟，缓存下来刷新页面不用重抽；
# 但它是本机产物，policy 一改就失效，不该进版本库。
console/.cache/
# 网关运行时目录（会话历史、任务状态）。conversation_history.restored 会从
# 这里恢复上一轮对话 —— 调试探针时要先清掉它，否则模型会认为任务已在办理。
.runtime/

# 双进程组各自的运行时目录（bootstrap/start.mjs 按域分开，否则两组的对话历史会串）
.runtime-*/
# 数据库编辑前的自动备份
domains/*/db.backup.json
