{
  "domain": "music",
  "label": "音乐",
  "description": "座舱示例的音乐播放、暂停、切歌和搜索能力。",
  "enabled": true,
  "functions": [
    {
      "name": "music_play",
      "label": "音乐播放",
      "description": "播放或继续播放音乐，可按歌曲名、歌手或专辑点歌。当前歌单：晴天、七里香、稻香、夜曲、简单爱、青花瓷",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "要播放的歌曲名、歌手、专辑或关键词；不填表示继续播放当前歌曲"
          }
        }
      }
    },
    {
      "name": "music_pause",
      "label": "音乐暂停",
      "description": "暂停当前音乐播放。",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "music_next",
      "label": "下一首",
      "description": "切换到下一首音乐。",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "music_previous",
      "label": "上一首",
      "description": "切换到上一首音乐。",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "music_search",
      "label": "音乐搜索",
      "description": "搜索歌曲、歌手或专辑，不直接开始播放。当前歌单：晴天、七里香、稻香、夜曲、简单爱、青花瓷",
      "enabled": true,
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "要搜索的歌曲名、歌手、专辑或关键词"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  ]
}
