# 客服示例的场景端点。四进程的默认端口只用于本地示例。
# 目前只有 service 一个进程，其余三个待接入。

CS_SERVICE_HOST=127.0.0.1
# 业务域。决定四样东西：人设（gateway/assistant/*.md）、前台工具白名单、
# policy 检索源、state-store 的默认库。改了要重启网关才生效。
CS_DOMAIN=retail

CS_SERVICE_PORT=3110
CS_SERVICE_ORIGIN=http://127.0.0.1:3110

# 前台 MCP 端点，默认由 CS_SERVICE_ORIGIN 推导，一般不用显式设置。
# CS_FRONTEND_MCP_URL=http://127.0.0.1:3110/mcp/frontend?sessionId=default

# 以下三个进程尚未实现，端口先占好，避免和 smart-cockpit（3010/3020/18888/5173）冲突。
CS_AGENT_HOST=127.0.0.1
CS_AGENT_PORT=3120
CS_AGENT_CARD_URL=http://127.0.0.1:3120/.well-known/agent-card.json
CS_GATEWAY_HOST=127.0.0.1
CS_GATEWAY_PORT=18889
CS_CLIENT_HOST=127.0.0.1
# 客服工作台。默认 4620；bootstrap/start.mjs 起航空组时自动 +100（4720）。
CS_CLIENT_PORT=4620

# 同一个 sessionId 下 UI 与 Agent 才能看到同一份业务状态。
CS_SESSION_ID=default

# 后台 Agent 的模型（OpenAI 兼容的 DashScope API）。接入 agent/ 之后才需要。
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen3.8-flash
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认的 DashScope Realtime 前台所需。接入 gateway/ 之后才需要。
QWEN_AUDIO_REALTIME_BASE_URL=
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_AUDIO_REALTIME_VOICE=longanqian
