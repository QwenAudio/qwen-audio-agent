# Copy to .env.local; npm run example:ai-passport loads that file.
# This starts the device relay only. Configure/start the Gateway separately.
# Keep real credentials private; this is a device token, NOT a model API key.
# Required: at least 24 characters; enter the same token in the hardware setup.
DEVICE_ACCESS_TOKEN=
# Existing Gateway on this computer. Use a different port from DEVICE_PORT.
GATEWAY_URL=http://127.0.0.1:18888
# Explicit trusted-LAN opt-in: change to 0.0.0.0 for the hardware card.
DEVICE_HOST=127.0.0.1
# The reference card defaults to 3101; keep it free for this relay.
DEVICE_PORT=3101
# Explicit trusted-LAN opt-in only; keep authentication enabled by default.
DEVICE_ALLOW_TOKEN_FREE=0
