    "concurrently": "^9.2.0",
    "electron-builder": "26.15.7",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "vitepress": "^1.6.4"
  },
