# 默认前台使用 Qwen Audio Realtime，此时需要填写 DashScope API Key。
DASHSCOPE_API_KEY=

# 可选：连接用户自行安装、配置并启动的 speech-to-speech 服务。
# Gateway 使用它时无需 DashScope API Key；该服务自己的 LLM 认证由用户配置。
# STT、LLM、TTS 和音色均由该服务管理。
# QWEN_AUDIO_REALTIME_PROVIDER=speech-to-speech
# SPEECH_TO_SPEECH_REALTIME_URL=ws://127.0.0.1:8765/v1/realtime

# 可选：选择后台 Agent；留空时仅使用前台实时语音聊天。
# OpenCode/OpenClaw 支持自动安装和百炼配置。
# 可选 openclaw、opencode、qoder、kimi、hermes、
# codebuddy、codex、claude、通用 acp 或 none。
AGENT_PROTOCOL=openclaw

# 配置后台后，Gateway 默认启动并管理所选 Agent 的 ACP 进程。
# QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native
# QWEN_AUDIO_AGENT_BACKEND_AGENT=
# 可选：显式覆盖后台模型；OpenCode/OpenClaw 会结合上面的 API Key 自动配置百炼。
# 留空时使用 Agent 原有模型。
# QWEN_AUDIO_AGENT_BACKEND_MODEL=

# 可选：指定 qwen-audio-agent 自己启动的后台服务监听地址。
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# Qoder 默认复用 qodercli 的登录和原生 Session 存储。
# QODERCLI_PATH=
# QODER_AUTH_MODE=cli

# Kimi Code 使用官方 kimi acp；可复用原生登录，或通过官方临时模型变量传入凭据。
# KIMI_CODE_BIN=
# KIMI_WORKSPACE=
# KIMI_CODE_HOME=
# KIMI_MODEL_NAME=kimi-for-coding
# KIMI_MODEL_API_KEY=
# KIMI_MODEL_BASE_URL=https://api.kimi.com/coding/v1

# Hermes 使用自己的模型与 provider 配置。
# HERMES_BIN=
# HERMES_WORKSPACE=

# CodeBuddy 需要先通过交互式 /login 完成一次账号登录。
# CODEBUDDY_BIN=
# CODEBUDDY_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# CODEBUDDY_WORKSPACE=

# Codex 通过 codex-acp 接入，并复用已安装 Codex 的用户配置。
# CODEX_ACP_BIN=
# CODEX_ACP_RUNTIME=auto
# CODEX_PATH=
# CODEX_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CODEX_WORKSPACE=

# Claude Code 通过 claude-code-acp 接入，并复用已安装客户端的配置。
# CLAUDE_CODE_ACP_BIN=
# CLAUDE_CODE_ACP_RUNTIME=auto
# CLAUDE_CODE_EXECUTABLE=
# CLAUDE_WORKSPACE=

# 任意支持 ACP stdio 的 Agent 可通过通用入口接入；参数建议使用 JSON 数组。
# AGENT_PROTOCOL=acp
# ACP_COMMAND=your-agent
# ACP_ARGS=["--acp"]
# ACP_LABEL=Your Agent
# ACP_WORKSPACE=

# 远程访问必须使用带认证的 HTTPS 反向代理，并显式填写其公开 Origin。
# QWEN_AUDIO_AGENT_ALLOWED_ORIGINS=https://voice.example.com
